# Copy to .env to override defaults locally. .env is auto-loaded by godotenv.

# HTTP server.
PORT=8080
BASE_URL=http://localhost:8080

# Environment label — informational only, logged at startup.
ENVIRONMENT=development

# Logger level. One of: debug, info, warn, error.
LOG_LEVEL=info

# Database backend. Either "sqlite" (default) or "postgres".
DATABASE_DRIVER=sqlite

# Connection string. Format depends on DATABASE_DRIVER.
#
#   sqlite:   a filesystem path or DSN. Foreign keys are enabled automatically
#             when the URL has no _pragma= parameter.
#               DATABASE_URL=golinks.db
#               DATABASE_URL=file:/var/lib/golinks/db.sqlite
#               DATABASE_URL=:memory:
#
#   postgres: a libpq-style URL.
#               DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=disable
#
# When DATABASE_DRIVER=sqlite and DATABASE_URL is empty, the deprecated
# DATABASE_PATH (default "golinks.db") is used to synthesise the URL. New
# deployments should set DATABASE_URL directly.
DATABASE_URL=

# Deprecated: kept for backward compatibility with pre-Phase-4 deployments.
# Only consulted when DATABASE_DRIVER=sqlite and DATABASE_URL is empty.
DATABASE_PATH=golinks.db
